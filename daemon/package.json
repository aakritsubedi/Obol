{
  "name": "@obol/daemon",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "once": "tsx src/index.ts --once",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.bundle.js --sourcemap --packages=external",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ccusage": "20.0.20"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
